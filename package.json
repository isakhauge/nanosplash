{
  "name": "nanosplash",
  "private": false,
  "version": "4.0.6",
  "type": "module",
  "author": {
    "name": "Isak K. Hauge",
    "email": "isakhauge@icloud.com",
    "url": "https://no.linkedin.com/in/isakhauge"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isakhauge/nanosplash.git"
  },
  "description": "The tiny loading screen for web artisans",
  "homepage": "https://github.com/isakhauge/nanosplash",
  "keywords": [
    "loading",
    "loader",
    "screen",
    "splash",
    "nano",
    "nanosplash",
    "small",
    "tiny",
    "es",
    "esm",
    "ts",
    "typescript",
    "iife",
    "cdn",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run build:es && bun run build:cjs && bun run build:iife",
    "build:es": "tsc && cross-env entry=./src/composables/ns.ts format=es vite build -m production --outDir dist/es",
    "build:cjs": "tsc && cross-env entry=./src/composables/ns.ts format=cjs vite build -m production --outDir dist/cjs",
    "build:iife": "tsc && cross-env entry=./src/iife.ts format=iife vite build -m production --outDir dist/iife",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"vite.config.ts\"",
    "test": "bunx vitest --coverage"
  },
  "types": "./src/types/global.d.ts",
  "exports": {
    ".": {
      "types": "./src/types/global.d.ts",
      "import": "./dist/es/ns.es.js",
      "require": "./dist/cjs/ns.cjs.js",
      "default": "./dist/es/ns.es.js"
    }
  },
  "source": "./src/composables/ns.ts",
  "unpkg": "./dist/iife/ns.iife.js",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitest/coverage-v8": "3.1.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
