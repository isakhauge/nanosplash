{
  "name": "nanosplash",
  "version": "4.1.2",
  "private": false,
  "description": "The tiny loading screen for web artisans",
  "keywords": [
    "cdn",
    "es",
    "esm",
    "iife",
    "loader",
    "loading",
    "nano",
    "nanosplash",
    "screen",
    "small",
    "splash",
    "tiny",
    "ts",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/isakhauge/nanosplash",
  "author": {
    "name": "Isak K. Hauge",
    "email": "isakhauge@icloud.com",
    "url": "https://no.linkedin.com/in/isakhauge"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isakhauge/nanosplash.git"
  },
  "source": "./src/composables/ns.ts",
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/es/ns.es.js",
  "types": "./types/global.d.ts",
  "unpkg": "./dist/iife/ns.iife.js",
  "jsdelivr": "./dist/iife/ns.iife.js",
  "exports": {
    ".": {
      "types": "./types/global.d.ts",
      "import": "./dist/es/ns.es.js",
      "require": "./dist/cjs/ns.cjs.js",
      "default": "./dist/es/ns.es.js"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "bun run build:es && bun run build:cjs && bun run build:iife && bun run build:docs",
    "build:es": "tsc && cross-env entry=./src/composables/ns.ts format=es vp build -m production --outDir ./dist/es",
    "build:cjs": "tsc && cross-env entry=./src/composables/ns.ts format=cjs vp build -m production --outDir ./dist/cjs",
    "build:iife": "tsc && cross-env entry=./src/iife.ts format=iife vp build -m production --outDir ./dist/iife",
    "build:docs": "tsc && cross-env entry=./src/docs.ts format=iife vp build -m production --outDir ./dist/docs && bun ./scripts/build-docs.ts",
    "preview": "vp preview",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test --coverage",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "warn"
    }
  }
}
