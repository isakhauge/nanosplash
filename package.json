{
  "name": "nanosplash",
  "private": false,
  "version": "4.0.20",
  "type": "module",
  "author": {
    "name": "Isak K. Hauge",
    "email": "isakhauge@icloud.com",
    "url": "https://no.linkedin.com/in/isakhauge"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isakhauge/nanosplash.git"
  },
  "description": "The tiny loading screen for web artisans",
  "homepage": "https://github.com/isakhauge/nanosplash",
  "keywords": [
    "loading",
    "loader",
    "screen",
    "splash",
    "nano",
    "nanosplash",
    "small",
    "tiny",
    "es",
    "esm",
    "ts",
    "typescript",
    "iife",
    "cdn",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run build:es && bun run build:cjs && bun run build:iife",
    "build:es": "tsc && cross-env entry=./src/composables/ns.ts format=es vite build -m production --outDir ./dist/es",
    "build:cjs": "tsc && cross-env entry=./src/composables/ns.ts format=cjs vite build -m production --outDir ./dist/cjs",
    "build:iife": "tsc && cross-env entry=./src/iife.ts format=iife vite build -m production --outDir ./dist/iife",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write ./src/**/*.ts ./vite.config.ts ./vitest.config.ts",
    "test": "bunx vitest --coverage"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "types": "./types/global.d.ts",
  "main": "./dist/es/ns.es.js",
  "exports": {
    ".": {
      "types": "./types/global.d.ts",
      "import": "./dist/es/ns.es.js",
      "require": "./dist/cjs/ns.cjs.js",
      "default": "./dist/es/ns.es.js"
    }
  },
  "source": "./src/composables/ns.ts",
  "unpkg": "./dist/iife/ns.iife.js",
  "jsdelivr": "./dist/iife/ns.iife.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "4.0.18",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
